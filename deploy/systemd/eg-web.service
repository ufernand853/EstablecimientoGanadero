[Unit]
Description=Establecimiento Ganadero Web (Next.js)
After=network.target eg-api.service
Wants=eg-api.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/workspace/EstablecimientoGanadero
Environment=NODE_ENV=production
EnvironmentFile=-/workspace/EstablecimientoGanadero/.env
Environment=PORT=3200
Environment=API_INTERNAL_URL=http://127.0.0.1:3201
ExecStartPre=/usr/bin/test -f /workspace/EstablecimientoGanadero/apps/web/.next/BUILD_ID
ExecStart=/usr/bin/env npm --workspace apps/web run start
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
