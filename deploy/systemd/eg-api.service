[Unit]
Description=Establecimiento Ganadero API
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/workspace/EstablecimientoGanadero
Environment=NODE_ENV=production
EnvironmentFile=-/workspace/EstablecimientoGanadero/.env
Environment=PORT=3201
ExecStart=/usr/bin/env npm --workspace apps/api run start
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
